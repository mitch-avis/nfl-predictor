{
    "default": true,
    "no-hard-tabs": true,
    "line-length": {
        "line_length": 100,
        "code_blocks": false,
        "tables": false
    },
    "no-duplicate-heading": {
        "siblings_only": true
    },
    "no-inline-html": {
        "allowed_elements": [
            "br",
            "hr",
            "kbd",
            "sup"
        ]
    }
}