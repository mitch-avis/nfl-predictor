from typing import Literal

import polars as pl

type _Seasons = int | list[int] | bool | None
type _SummaryLevel = Literal["week", "reg", "post", "reg+post"]

def clear_cache(pattern: str | None = None) -> None: ...
def load_pbp(seasons: _Seasons = None) -> pl.DataFrame: ...
def load_player_stats(
    seasons: _Seasons = None, summary_level: _SummaryLevel = "week"
) -> pl.DataFrame: ...
def load_players() -> pl.DataFrame: ...
def load_rosters(seasons: _Seasons = None) -> pl.DataFrame: ...
def load_rosters_weekly(seasons: _Seasons = None) -> pl.DataFrame: ...
def load_schedules(seasons: _Seasons = True) -> pl.DataFrame: ...
def load_snap_counts(seasons: _Seasons = None) -> pl.DataFrame: ...
def load_team_stats(
    seasons: _Seasons = None, summary_level: _SummaryLevel = "week"
) -> pl.DataFrame: ...
